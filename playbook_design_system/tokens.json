{
  "$meta": {
    "name": "Playbook — Design OS",
    "version": "1.0",
    "description": "Calm, glyph-driven design system for a personal design-ops tool (task queue, daily planning, brag doc).",
    "themes": ["light", "dark"]
  },
  "color": {
    "light": {
      "paper":        "#f4f3ef",
      "surface":      "#ffffff",
      "surface-2":    "#ebe9e3",
      "line":         "#e4e1d9",
      "ink-3":        "#9a958b",
      "ink-2":        "#6a665d",
      "ink":          "#1b1a17",
      "accent":       "#2f4fd6",
      "accent-soft":  "#e7ebfb",
      "success":      "#2f885a",
      "success-soft": "#e0f0e7",
      "warning":      "#b07d16",
      "warning-soft": "#f6ecd5",
      "danger":       "#c23a2c",
      "danger-soft":  "#f7e1dc",
      "brag":         "#7a4fd6",
      "brag-soft":    "#ece4fb"
    },
    "dark": {
      "paper":        "#141310",
      "surface":      "#1d1c19",
      "surface-2":    "#262420",
      "line":         "#2f2d28",
      "ink-3":        "#6e6a61",
      "ink-2":        "#a6a199",
      "ink":          "#f1efe9",
      "accent":       "#7088ff",
      "accent-soft":  "#1c2342",
      "success":      "#4fb583",
      "success-soft": "#163020",
      "warning":      "#e0a83c",
      "warning-soft": "#322713",
      "danger":       "#e06a5b",
      "danger-soft":  "#38201c",
      "brag":         "#a98bff",
      "brag-soft":    "#221a3a"
    }
  },
  "semanticRoles": {
    "accent":  "Active work, links, primary actions, In Progress state",
    "success": "Shipped tasks, positive metrics, Completed state",
    "warning": "Queued / awaiting tasks, Pending state",
    "danger":  "Past-due items, destructive actions, Overdue state",
    "brag":    "Wins and the Brag Doc accent"
  },
  "typography": {
    "fontSans": "'Hanken Grotesk', system-ui, sans-serif",
    "fontMono": "'IBM Plex Mono', ui-monospace, monospace",
    "googleFonts": "https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&display=swap",
    "scale": {
      "display":  { "size": 52, "lineHeight": 1.05, "weight": 700, "letterSpacing": "-0.03em", "font": "sans" },
      "h1":       { "size": 36, "lineHeight": 1.1,  "weight": 700, "letterSpacing": "-0.02em", "font": "sans" },
      "h2":       { "size": 24, "lineHeight": 1.2,  "weight": 600, "letterSpacing": "-0.01em", "font": "sans" },
      "h3":       { "size": 18, "lineHeight": 1.3,  "weight": 600, "letterSpacing": "0",       "font": "sans" },
      "body":     { "size": 16, "lineHeight": 1.6,  "weight": 400, "letterSpacing": "0",       "font": "sans" },
      "caption":  { "size": 12, "lineHeight": 1.4,  "weight": 500, "letterSpacing": "0.04em",  "font": "mono", "transform": "uppercase" }
    },
    "rules": "Mono carries ALL metadata: labels, dates, counts, numerics, eyebrows, and the glyph icons. Sans carries everything else."
  },
  "spacing": {
    "base": 4,
    "scale": { "1": 4, "2": 8, "3": 12, "4": 16, "6": 24, "8": 32, "12": 48, "16": 64 }
  },
  "radius": { "sm": 6, "md": 10, "lg": 14, "full": 999 },
  "elevation": "Implied by tone, not shadow. Cards = 1px var(--line) border on var(--surface). Reserve real shadows for floating/overlay surfaces only (modals, the hero showcase frame, toasts).",
  "iconography": {
    "principle": "Icons are typographic glyphs set in IBM Plex Mono — never drawn SVG artwork. They scale with the type and inherit color.",
    "glyphs": {
      "dashboard": "◈", "today": "◆", "tomorrow": "→", "queue": "▪",
      "allTasks": "≡", "bragDoc": "✦", "settings": "⚙", "sync": "↻",
      "done": "✓", "disclose": "›", "add": "+"
    }
  },
  "motion": {
    "easing": "cubic-bezier(0.4, 0, 0.2, 1)",
    "durations": { "fast": "180ms", "base": "240ms", "theme": "350ms" },
    "principles": ["Animate state changes only", "160–280ms ease-out", "No bounce or spin — grounded and predictable"]
  }
}
