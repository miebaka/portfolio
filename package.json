{
  "name": "miebaka-joshua-portfolio",
  "version": "1.1.3",
  "private": true,
  "description": "Build and image-optimization tooling for Miebaka Joshua's static portfolio.",
  "scripts": {
    "build": "npm run validate:content && node scripts/build-site.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "test:content": "node --test tests/content-schema.test.mjs",
    "test:navigation": "node --test tests/navigation.test.mjs",
    "test:case": "node --test tests/case-study.test.mjs",
    "test:professional": "node --test tests/professional-evidence.test.mjs",
    "test:contact-api": "node --test tests/contact-api.test.mjs",
    "dev": "npx serve . --listen 4000 --no-clipboard",
    "optimize:images": "node scripts/optimize-images.mjs",
    "test:integrity": "node --test scripts/site-integrity.test.mjs",
    "test:contract": "node --test scripts/visual-contract.test.mjs",
    "test": "npm run test:content && npm run test:navigation && npm run test:case && npm run test:professional && npm run test:contact-api && npm run build && npm run test:integrity && npm run test:contract"
  },
  "devDependencies": {
    "sharp": "^0.35.5"
  },
  "type": "module",
  "dependencies": {
    "three": "^0.180.0"
  }
}
